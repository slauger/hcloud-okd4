{
  "variables": {
    "location": "nbg1",
    "server_type": "cpx32",
    "snapshot_prefix": "rhcos",
    "image_type": "generic",
    "ignition_config": "config-3.0.0.ign",
    "first_boot_kargs": "rd.neednet=1 ip=dhcp nameserver=1.1.1.1 nameserver=1.0.0.1",
    "architecture": "x86",
    "rhcos_url": null,
    "rhcos_sha256": null,
    "rhcos_stream": "",
    "rhcos_release": ""
  },
  "builders": [
    {
      "type": "hcloud",
      "image": "ubuntu-22.04",
      "location": "{{user `location`}}",
      "server_type": "{{user `server_type`}}",
      "ssh_username": "root",
      "rescue": "linux64",
      "snapshot_name": "{{user `snapshot_prefix`}}-{{timestamp}}",
      "snapshot_labels": {
        "os": "rhcos",
        "image_type": "{{user `image_type`}}",
        "rhcos_stream": "{{user `rhcos_stream`}}",
        "rhcos_release": "{{user `rhcos_release`}}",
        "architecture": "{{user `architecture`}}"
      }
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "set -x",
        "mkdir /source",
        "mount -t tmpfs -o size=4G none /source",
        "cd /source",
        "curl -sfL {{user `rhcos_url`}} | gzip -d > rhcos-x86_64-qemu.x86_64.qcow2",
        "echo '{{user `rhcos_sha256`}}  rhcos-x86_64-qemu.x86_64.qcow2' | sha256sum -c -",
        "qemu-img convert rhcos-x86_64-qemu.x86_64.qcow2 -O raw /dev/sda",
        "partprobe /dev/sda",
        "mkdir /target",
        "udevadm settle",
        "mount \"$(blkid -L boot)\" /target",
        "mkdir /target/ignition"
      ]
    },
    {
      "type": "file",
      "source": "{{user `ignition_config`}}",
      "destination": "/target/ignition/config.ign"
    },
    {
      "type": "shell",
      "inline": [
        "set -x",
        "cat /target/ignition.firstboot || true",
        "echo \"set ignition_network_kcmdline='{{user `first_boot_kargs`}}'\" > /target/ignition.firstboot",
        "cat /target/ignition.firstboot",
        "cd /",
        "umount /source",
        "umount /target"
      ]
    }
  ]
}
