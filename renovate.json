{
  "extends": [
    "github>slauger/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)[^/]+\\.pkr\\.hcl$/"
      ],
      "matchStrings": [
        "#[ \\t]+renovate:[ \\t]+datasource=(?<datasource>.*?)[ \\t]+depName=(?<depName>.*?)\\s+version[ \\t]+=[ \\t]+\"(?<currentValue>[^\"]*)\"\\s"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "updateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "groupName": "all terraform dependencies",
      "groupSlug": "terraform-all"
    }
  ]
}
