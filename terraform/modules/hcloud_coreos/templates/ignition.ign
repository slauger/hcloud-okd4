{
  "ignition": {
    "config": {
      %{ if ignition_version == "3.0.0" }"merge": [%{ else }"append": [%{ endif }
        {
          "source": "${ignition_url}"%{ if ignition_cacert == "" },
          "verification": {}%{ endif }
        }
      ]
    },%{ if ignition_cacert != "" }
    "security": {
      "tls": {
        "certificateAuthorities": [
          {
            "source": "${ignition_cacert}"
          }
        ]
      }
    },%{ endif }
    "timeouts": {},
    "version": "${ignition_version}"
  },
  "passwd": {},
  "storage": {
    "files": [
      {
        "group": {},
        "overwrite": true,
        "path": "/etc/hostname",
        "user": {},
        "contents": {
          "source": "data:text/plain;charset=utf-8;base64,${hostname_b64}",
          "verification": {}
        },
        "mode": 420
      },
      {
        "group": {},
        "overwrite": true,
        "path": "/etc/systemd/system/kubelet.service.d/20-nodenet.conf",
        "user": {},
        "contents": {
          "source": "data:text/plain;charset=utf-8;base64,${base64encode("[Service]\nEnvironment=\"KUBELET_NODE_IP=${node_ip}\" \"KUBELET_NODE_IPS=${node_ip}\"\n")}",
          "verification": {}
        },
        "mode": 420
      },
      {
        "group": {},
        "overwrite": true,
        "path": "/etc/systemd/system/crio.service.d/20-nodenet.conf",
        "user": {},
        "contents": {
          "source": "data:text/plain;charset=utf-8;base64,${base64encode("[Service]\nEnvironment=\"CONTAINER_STREAM_ADDRESS=${node_ip}\"\n")}",
          "verification": {}
        },
        "mode": 420
      },
      {
        "group": {},
        "overwrite": true,
        "path": "/etc/NetworkManager/system-connections/public.nmconnection",
        "user": {},
        "contents": {
          "source": "data:text/plain;charset=utf-8;base64,${public_nm_b64}",
          "verification": {}
        },
        "mode": 384
      },
      {
        "group": {},
        "overwrite": true,
        "path": "/etc/NetworkManager/system-connections/private.nmconnection",
        "user": {},
        "contents": {
          "source": "data:text/plain;charset=utf-8;base64,${private_nm_b64}",
          "verification": {}
        },
        "mode": 384
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Use the private address as node IP\nBefore=nodeip-configuration.service\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/bash -c 'mkdir -p /run/nodeip-configuration; echo -n ${node_ip} > /run/nodeip-configuration/primary-ip; echo -n ${node_ip} > /run/nodeip-configuration/ipv4'\n[Install]\nWantedBy=multi-user.target nodeip-configuration.service\n",
        "enabled": true,
        "name": "hcloud-nodeip.service"
      },
      {
        "contents": "[Unit]\nConditionFirstBoot=yes\n[Service]\nType=idle\nExecStart=/usr/bin/hostnamectl set-hostname ${hostname}\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "set-hostname-firstboot.service"
      }
    ]
  }
}
